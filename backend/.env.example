# Copy this file to .env and fill in real values.
#   cp .env.example .env

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-a-real-secret-key

# True locally, must be False in production.
DEBUG=True

# Comma-separated list of hosts/domains allowed to serve this app.
# Required (non-empty) whenever DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of scheme://host origins allowed to submit
# cross-origin POSTs. Required (non-empty) whenever DEBUG=False and the
# app sits behind HTTPS, e.g. https://fexo-backend.onrender.com
CSRF_TRUSTED_ORIGINS=

# Set to False to disable the automatic HTTP->HTTPS redirect (only if
# you're intentionally serving plain HTTP without a TLS-terminating proxy
# in front). Only read when DEBUG=False.
SECURE_SSL_REDIRECT=True

# PostgreSQL connection
DB_NAME=fexo_db
DB_USER=fexo_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# The frontend is a separate Next.js app that talks to this project only
# over the JSON API mounted under /api/ — these two settings are what
# connect the two:

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the Next.js frontend, used to build links back to it (e.g.
# the password-reset confirmation link sent by email).
FRONTEND_URL=http://localhost:3000

# Set to "require" for hosted Postgres providers that enforce SSL (e.g. Neon).
# Leave unset ("prefer") for local Postgres.
# DB_SSLMODE=require

# S3 media storage — admin-uploaded product/category/banner images etc.
# Set USE_S3=True to store them in the bucket below instead of local disk
# (required on hosts with an ephemeral filesystem, e.g. Render). Leave
# USE_S3 unset/False for local dev without an AWS account.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Razorpay (online payments). Test keys start with rzp_test_. The webhook
# secret is set when you add a webhook in the Razorpay dashboard pointing at
# https://<backend>/api/payments/razorpay/webhook/ (events: payment.captured,
# payment.failed, order.paid, refund.processed). Leave blank to disable it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
