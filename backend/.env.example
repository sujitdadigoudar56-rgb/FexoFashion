# Copy this file to .env and fill in real values.
#   cp .env.example .env

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-a-real-secret-key

# True locally, must be False in production.
DEBUG=True

# Comma-separated list of hosts/domains allowed to serve this app.
# Required (non-empty) whenever DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_NAME=fexo_db
DB_USER=fexo_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Path to the frontend repo checkout (templates + static assets).
# Leave unset to default to a sibling "../frontend" folder, which is what
# you get when backend/ and frontend/ are cloned side by side.
# FRONTEND_DIR=/absolute/path/to/frontend
